# AquaSense Satellite River Monitoring Environment Variables

PORT=5000
NODE_ENV=development

# Copernicus Data Space Ecosystem (CDSE)
# https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Sentinel Hub API
# https://www.sentinel-hub.com/
SENTINEL_HUB_INSTANCE_ID=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Microsoft Planetary Computer (Optional API key for higher rate limits)
PC_SUBSCRIPTION_KEY=

# NASA Earthdata (SWOT / PO.DAAC)
# Create a free login at https://urs.earthdata.nasa.gov/
# Then generate a token at https://urs.earthdata.nasa.gov/users/<your-username>/tokens
# and paste it below. Required for real SWOT river measurements (width, water level, slope).
NASA_EARTHDATA_KEY=
NASA_EARTHDATA_TOKEN=

# Google Earth Engine (Optional Service Account)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=
GEE_PROJECT_ID=

# AI Remote Sensing Insights (OpenRouter / Gemini API Key)
VITE_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
