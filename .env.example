# AquaSense Satellite River Monitoring Environment Variables

PORT=5050
NODE_ENV=development

# Node ML proxy target (Flask water-quality + satellite processor)
WATER_QUALITY_MODEL_URL=http://127.0.0.1:5001

# NASA Earthdata (SWOT / PO.DAAC)
# Create a free login at https://urs.earthdata.nasa.gov/
# Then generate a token at https://urs.earthdata.nasa.gov/users/<your-username>/tokens
# and paste it below. Required for real SWOT river measurements (width, water level, slope).
NASA_EARTHDATA_KEY=
NASA_EARTHDATA_TOKEN=

# AI Remote Sensing Insights (OpenRouter / Gemini API Key)
VITE_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# MongoDB Atlas (optional). When set, the server uses MongoDB instead of SQLite.
# Create a free cluster at https://www.mongodb.com/atlas and paste the connection string below.
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=aquasense